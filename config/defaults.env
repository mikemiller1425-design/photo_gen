# photo_gen — default generation settings (override per prompt file or CLI)

# WebUI / Forge API (local, no cloud)
WEBUI_URL="${WEBUI_URL:-http://127.0.0.1:7860}"
WEBUI_API="${WEBUI_API:-${WEBUI_URL}/sdapi/v1}"

# Baseline reference (your gym photo — add file locally, gitignored)
REF_IMAGE="${REF_IMAGE:-references/baseline_gym.jpg}"

# Output
OUTPUT_DIR="${OUTPUT_DIR:-outputs}"
OUTPUT_PREFIX="${OUTPUT_PREFIX:-photo_gen}"

# img2img — lower = more faithful to reference pose/body/face
DENOISING_STRENGTH="${DENOISING_STRENGTH:-0.38}"
CFG_SCALE="${CFG_SCALE:-7.5}"
STEPS="${STEPS:-30}"
SAMPLER="${SAMPLER:-DPM++ 2M Karras}"
SEED="${SEED:--1}"

# Resolution (adjust to your baseline aspect ratio)
WIDTH="${WIDTH:-832}"
HEIGHT="${HEIGHT:-1216}"

# Forge install location (outside repo; models symlinked from ./models)
FORGE_DIR="${FORGE_DIR:-$HOME/stable-diffusion-webui-forge}"